# Optional. Create a GA4 property, then paste the Measurement ID (G-XXXXXXXX).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional. HTML tag from Search Console → Settings → Ownership verification.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional until you want the contact and newsletter forms to send mail.
# Create a Resend account, verify vlirtz.com, then add the API key in Vercel.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=VLIRTZ <noreply@vlirtz.com>
CONTACT_TO_EMAIL=info@vlirtz.com

# "Book a call" widget (Cal.com). Create a Cal.com account signed in with
# borja.javierre@gmail.com and create two event types, both with location
# "Cal Video" (Cal.com's built-in conferencing; no Google account or
# calendar connection needed, even though the account itself is a personal
# Gmail): one 15-minute event and one 30-minute event. Then paste each
# username/slug below.
NEXT_PUBLIC_CAL_LINK_15MIN=borja-javierre/15min
NEXT_PUBLIC_CAL_LINK_30MIN=borja-javierre/30min

# In that event type's Cal.com settings, add a webhook: Subscriber URL
# https://vlirtz.com/api/cal-webhook, event "Booking Created", with a secret
# key. Paste that same secret here so we can verify the payload is genuine.
CAL_WEBHOOK_SECRET=

# Who gets a copy of every "Book a call" confirmation, in addition to the
# lead and the Cal.com organizer account.
SALES_NOTIFICATION_EMAIL=sales@vlirtz.com
