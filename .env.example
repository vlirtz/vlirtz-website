# Optional. Create a GA4 property, then paste the Measurement ID (G-XXXXXXXX).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional. HTML tag from Search Console → Settings → Ownership verification.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional until you want the contact and newsletter forms to send mail.
# Create a Resend account, verify vlirtz.com, then add the API key in Vercel.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=VLIRTZ <noreply@vlirtz.com>
CONTACT_TO_EMAIL=info@vlirtz.com
