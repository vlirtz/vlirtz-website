# ---------------------------------------------------------------------------
# VLIRTZ website + sales agent
#
# Copy to .env.local for local development, or paste into the Vercel project.
# Everything is optional: with an empty file the site builds and the chat widget
# runs in demo mode (scripted replies, local keyword retrieval, in-memory leads).
# ---------------------------------------------------------------------------

# --- Sales agent: model -----------------------------------------------------
# Required for real agent replies. Without it the widget uses the scripted
# demo model and says so in its answers.
OPENAI_API_KEY=

# Optional overrides. Defaults shown.
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Sales agent: PostgreSQL (leads + conversations) ------------------------
# Without this, leads are kept in memory for the life of the server process
# and logged to the console. Example:
#   postgresql://user:password@localhost:5432/vlirtz?schema=public
# After setting it, run: npx prisma migrate dev --name init
DATABASE_URL=

# --- Sales agent: Pinecone (knowledge base) ---------------------------------
# Without these, the agent falls back to BM25 keyword search over the site's
# own content in content/posts and src/lib/site.ts.
PINECONE_API_KEY=
# Serverless cloud and region. Accepts "us-east-1" or "aws:us-east-1".
PINECONE_ENVIRONMENT=aws:us-east-1
PINECONE_INDEX_NAME=vlirtz-knowledge-base
# Optional: partition one index across environments.
# PINECONE_NAMESPACE=

# --- Sales agent: booking ---------------------------------------------------
# Cal.com link used by the widget CTA and offered by the agent.
NEXT_PUBLIC_CAL_LINK=https://cal.com/vlirtz/discovery-call

# Origin crawled by `npm run ingest -- --site`.
# INGEST_BASE_URL=https://vlirtz.com

# --- Website: analytics and SEO (optional) ----------------------------------
# Create a GA4 property, then paste the Measurement ID (G-XXXXXXXX).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# HTML tag from Search Console → Settings → Ownership verification.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Website: contact and newsletter forms (optional) -----------------------
# Create a Resend account, verify vlirtz.com, then add the API key.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=VLIRTZ <noreply@vlirtz.com>
CONTACT_TO_EMAIL=info@vlirtz.com

# "Book a call" widget (Cal.com). Create a Cal.com account signed in with
# borja.javierre@gmail.com and create two event types, both with location
# "Cal Video" (Cal.com's built-in conferencing; no Google account or
# calendar connection needed, even though the account itself is a personal
# Gmail): one 15-minute event and one 30-minute event. Then paste each
# username/slug below.
NEXT_PUBLIC_CAL_LINK_15MIN=borja-javierre/15min
NEXT_PUBLIC_CAL_LINK_30MIN=borja-javierre/30min

# In that event type's Cal.com settings, add a webhook: Subscriber URL
# https://vlirtz.com/api/cal-webhook, event "Booking Created", with a secret
# key. Paste that same secret here so we can verify the payload is genuine.
CAL_WEBHOOK_SECRET=

# Who gets a copy of every "Book a call" confirmation, in addition to the
# lead and the Cal.com organizer account.
SALES_NOTIFICATION_EMAIL=sales@vlirtz.com
