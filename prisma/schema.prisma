// Vlirtz sales agent data layer.
//
// Apply with:
//   npx prisma migrate dev --name init      (local, creates a migration)
//   npx prisma db push                      (quick sync, no migration file)
//
// The app runs without DATABASE_URL: src/lib/agent/db/client.ts falls back to
// an in-memory store, so local development and CI builds never need Postgres.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Prisma 7 no longer accepts `url` here. The connection string is read from
// DATABASE_URL in prisma.config.ts (for the CLI) and passed to the driver
// adapter in src/lib/agent/db/client.ts (at runtime).
datasource db {
  provider = "postgresql"
}

/// How far a visitor got in the sales conversation.
enum LeadStatus {
  NEW
  QUALIFIED
  CALL_BOOKED
  DISQUALIFIED
}

/// A visitor who shared contact details or asked to book a discovery call.
model Lead {
  id String @id @default(cuid())

  name        String?
  email       String?
  companyName String?
  /// Free-text summary of what the visitor wants built.
  projectDetails String?
  /// Budget, timeline, and team size when the visitor volunteers them.
  budget   String?
  timeline String?

  status LeadStatus @default(NEW)
  /// 0-100 qualification score the agent assigns from the conversation.
  score Int @default(0)

  /// True once the agent has handed off the Cal.com link.
  bookingRequested Boolean @default(false)

  /// Conversation that produced this lead.
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

/// One chat session with the widget, stored for analytics.
model Conversation {
  id String @id @default(cuid())

  /// Stable id generated by the widget and echoed back on every request.
  sessionId String @unique

  /// Page the conversation started on, for attribution.
  sourceUrl String?
  userAgent String?

  messages Message[]
  leads    Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

/// Author of a stored chat message.
enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

/// A single turn inside a {@link Conversation}.
model Message {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    MessageRole
  content String

  /// Tool name when `role` is TOOL, so tool usage is queryable.
  toolName String?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}
